{
  "name": "multigender-hebrew-text-designer",
  "version": "0.2.9",
  "description": "MultiGender Hebrew Text Designer - A modern text-to-image generator for Hebrew typography",
  "main": "src/script.js",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "deploy:staging": "wrangler pages deploy src --project-name staging-amba",
    "deploy:production": "wrangler pages deploy src --project-name noamba",
    "dev:serve": "npx http-server ./src -p 8080 -c-1",
    "test:e2e": "start-server-and-test dev:serve http://127.0.0.1:8080 cypress:run",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome --headless"
  },
  "keywords": [
    "hebrew",
    "multigender",
    "text",
    "designer",
    "canvas",
    "typography",
    "rtl"
  ],
  "author": "Mark",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/komapc/noamba"
  },
  "devDependencies": {
    "cypress": "13.14.2",
    "http-server": "14.1.1",
    "start-server-and-test": "2.0.3"
  }
}