{
  "name": "multigender-hebrew-text-designer",
  "version": "1.0.0",
  "description": "Client-side MultiGender Hebrew text-to-image generator with special character keyboard",
  "main": "src/index.html",
  "scripts": {
    "start": "echo \"Open src/index.html in your browser - no server required!\"",
    "serve": "npx http-server src -p 8000 -o",
    "serve:staging": "npx http-server . -p 8000 -o test-staging.html",
    "build": "echo \"Static site - no build required\"",
    "test:staging": "echo \"Visit http://localhost:8000/src/index.html?staging=true to test staging mode\"",
    "deploy:staging": "echo 'Use Cloudflare Dashboard: https://dash.cloudflare.com/pages'",
    "deploy:production": "echo 'Use Cloudflare Dashboard: https://dash.cloudflare.com/pages'",
    "deploy:preview": "echo 'Use Cloudflare Dashboard: https://dash.cloudflare.com/pages'"
  },
  "keywords": ["hebrew", "multigender", "text", "image", "canvas", "client-side"],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
